<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <section class="section confirmation">
    <h1>Thank you, <%= order.customer_name %>! 🍕</h1>
    <p>Your order <strong>#<%= order.id %></strong> has been received and is being prepared.</p>

    <table class="cart-table">
      <thead><tr><th>Pizza</th><th>Qty</th><th>Subtotal</th></tr></thead>
      <tbody>
        <% order.items.forEach(function(item) { %>
          <tr>
            <td><%= item.name %></td>
            <td><%= item.qty %></td>
            <td>Rs. <%= (item.price * item.qty).toLocaleString('en-LK') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="cart-total">Total Paid: Rs. <%= order.total.toLocaleString('en-LK') %></p>
    <p>Delivering to: <%= order.address %></p>

    <a href="/menu" class="btn btn-primary">Order More</a>
  </section>

  <%- include('partials/footer') %>
  <script>localStorage.removeItem('cart');</script>
</body>
</html>
