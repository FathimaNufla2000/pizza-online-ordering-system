<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <h1 class="section-title">Feedback</h1>

    <% if (typeof submitted !== 'undefined' && submitted) { %>
      <div class="success-state">
        <p>Thank you for your feedback! We appreciate you taking the time.</p>
      </div>
    <% } else { %>
      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-error"><%= error %></p>
      <% } %>
      <form class="feedback-form" action="/feedback" method="POST">
        <label for="name">First Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required>

        <label for="email">Your Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>

        <label for="district">District</label>
        <select name="district" id="district" required>
          <option value="" disabled selected>Select your district</option>
          <% districts.forEach(function(d) { %>
            <option value="<%= d %>"><%= d %></option>
          <% }) %>
        </select>

        <label for="message">Your Feedback</label>
        <textarea name="message" id="message" rows="6" placeholder="Tell us about your experience" required></textarea>

        <button type="submit" class="btn btn-primary">Submit Feedback</button>
      </form>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
